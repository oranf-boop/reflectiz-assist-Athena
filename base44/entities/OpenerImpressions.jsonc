{
  "name": "OpenerImpressions",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "title": "Session ID"
    },
    "pageUrl": {
      "type": "string",
      "title": "Page URL"
    },
    "openerText": {
      "type": "string",
      "title": "Opener Text",
      "format": "textarea"
    },
    "bubbleText": {
      "type": "string",
      "title": "Bubble Text"
    },
    "shownAt": {
      "type": "string",
      "format": "date-time",
      "title": "Shown At"
    },
    "bubbleVariant": {
      "type": "string",
      "title": "Bubble Variant",
      "default": "A"
    },
    "clientImpressionId": {
      "type": "string",
      "title": "Client Impression ID"
    },
    "geo": {
      "type": "string",
      "title": "Geo"
    },
    "wasFallback": {
      "type": "boolean",
      "title": "Was Fallback",
      "default": false
    },
    "dismissed": {
      "type": "boolean",
      "title": "Dismissed",
      "default": false
    },
    "expired": {
      "type": "boolean",
      "title": "Expired",
      "default": false
    },
    "abandoned": {
      "type": "boolean",
      "title": "Abandoned",
      "default": false
    },
    "timeVisibleMs": {
      "type": "number",
      "title": "Time Visible (ms)"
    }
  },
  "required": []
}